region       = "eu-central-1"
project_name = "savepoint"
environment  = "dev"
app_url      = "http://localhost:6060"
# Must be globally unique in region. Change to your value.
domain_prefix = "savepoint-dev-abc123"
enable_cognito_native = false

# Optional: enable Google as Cognito IdP
# google_client_id     = "..."
# google_client_secret = "..."

# --- Address cutover ---
# app_url becomes the NEW origin. The old origin stays in Cognito callback and
# logout URLs (as <origin>/api/auth/callback/cognito and <origin>).
# app_url = "https://<new>.vercel.app"
# additional_callback_urls = ["https://<old>.vercel.app"]
# Never change project_name or domain_prefix (ForceNew).

# --- S3 (Production-like) ---
# Pin the EXISTING bucket name so a future project_name change cannot replace the bucket.
# Copy it from `terraform output s3_bucket_name` (or `terraform state show module.s3.aws_s3_bucket.this`).
# Left empty, the name is derived as "${project_name}-${environment}-${account_id}-${region}".
# s3_bucket_name = "<existing bucket name>"

# Additional CORS origins (app_url is always included).
# Address cutover: keep the old origin allowed until the old host redirects.
# s3_additional_allowed_origins = [
#   "https://<old>.vercel.app"
# ]

# Optional: attach S3 access policy to an existing ECS task role by name
# s3_ecs_task_role_name = "savepoint-dev-task-role"
